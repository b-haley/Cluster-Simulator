<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="ThemeName">NeonDashboard</sys:String>

    <SolidColorBrush x:Key="BrushAppBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#0B1220"/>
    <SolidColorBrush x:Key="BrushTopBar" Color="#0B1220"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#243449"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#475569"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#22D3EE"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#4FE0F7"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#12B5CF"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#2622D3EE"/>
    <SolidColorBrush x:Key="BrushAccentForeground" Color="#062A30"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#34D399"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#F87171"/>
    <SolidColorBrush x:Key="BrushTrack" Color="#334155"/>
    <SolidColorBrush x:Key="BrushGridLine" Color="#243449"/>
    <SolidColorBrush x:Key="BrushRowHover" Color="#1422D3EE"/>
    <SolidColorBrush x:Key="BrushRowSelected" Color="#2622D3EE"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushSidebarSelected" Color="#1F22D3EE"/>

</ResourceDictionary>