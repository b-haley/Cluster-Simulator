<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ClusterSim.Wpf.Controls">

    <Style TargetType="controls:RangeSlider">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:RangeSlider">
                    <Grid Height="28">
                        <Border x:Name="PART_Track" Height="4" VerticalAlignment="Center"
                                CornerRadius="2" Background="{DynamicResource BrushTrack}"/>
                        <Canvas Background="Transparent" VerticalAlignment="Stretch">
                            <Border x:Name="PART_Range" Height="4" Canvas.Top="12"
                                    CornerRadius="2" Background="{DynamicResource BrushAccent}"/>
                            <Thumb x:Name="PART_LowerThumb" Canvas.Top="6"
                                   Style="{StaticResource RangeSliderThumb}"/>
                            <Thumb x:Name="PART_UpperThumb" Canvas.Top="6"
                                   Style="{StaticResource RangeSliderThumb}"/>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>