<Window x:Class="ClusterSim.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClusterSim.Wpf.Controls"
        Title="ClusterSim — симулятор кластерного планировщика"
        Width="1320" Height="840"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushAppBackground}">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="B" Background="Transparent" CornerRadius="8,8,0,0" Padding="16,10" Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Background="Transparent" Margin="12,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushSurface}"/>
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushRowSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Style="{StaticResource TopBar}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppTitle}" Text="ClusterSim" VerticalAlignment="Center"/>
                <controls:ThemeSwitcherControl DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Индикатор -->
        <ProgressBar Grid.Row="1" Height="4" Background="{DynamicResource BrushTrack}" Foreground="{DynamicResource BrushAccent}" IsIndeterminate="{Binding IsRunning}"/>

        <!-- Контент -->
        <TabControl Grid.Row="2" Margin="16,12,16,0">

            <!-- 1. Конструктор кластера -->
            <TabItem Header="1. Конструктор кластера">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource CardTitle}" Text="Редактор узлов"/>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Название"/>
                                        <TextBox Text="{Binding Designer.ClusterName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Описание"/>
                                        <TextBox Text="{Binding Designer.Description, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Designer.Nodes}" SelectedItem="{Binding Designer.SelectedNode}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя узла" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuCores, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                    <DataGridTextColumn Header="RAM, МБ" Binding="{Binding RamMb, UpdateSourceTrigger=LostFocus}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="Добавить узел" Command="{Binding Designer.AddNodeCommand}" MinWidth="140" Margin="0,0,8,0"/>
                                <Button Content="Удалить узел" Command="{Binding Designer.RemoveSelectedNodeCommand}" MinWidth="140" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource ButtonPrimary}" Content="Сохранить кластер" Command="{Binding SaveClusterCommand}" MinWidth="170"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Сохраненные кластеры"/>
                            <ListBox Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding AvailableClusters}" SelectedItem="{Binding SelectedCluster}" DisplayMemberPath="Name"/>
                            <StackPanel Grid.Row="2">
                                <Button Style="{StaticResource ButtonDanger}" Content="Удалить" Command="{Binding DeleteSelectedClusterCommand}" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource ButtonGhost}" Content="Обновить список" Command="{Binding Designer.RefreshSavedCommand}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Style="{StaticResource CardSubtitle}" Text="{Binding ClusterStatusMessage}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2. Конструктор заданий -->
            <TabItem Header="2. Конструктор заданий">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Параметры workload"/>
                                <UniformGrid Columns="2" Margin="0,8,0,12">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Название"/>
                                        <TextBox Text="{Binding WorkloadName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Описание"/>
                                        <TextBox Text="{Binding WorkloadDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Заданий"/>
                                        <TextBox Text="{Binding JobCount, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Seed"/>
                                        <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Заданий в час"/>
                                        <TextBox Text="{Binding ArrivalRatePerHour, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Длительность, сек (от и до)"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding MinDurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:RangeSlider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="7200" LowerValue="{Binding MinDurationSeconds}" UpperValue="{Binding MaxDurationSeconds}"/>
                                    <TextBox Grid.Column="2" Text="{Binding MaxDurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ядра CPU (от и до)"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding MinCpuCores, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:RangeSlider Grid.Column="1" Margin="12,0" Minimum="1" Maximum="64" LowerValue="{Binding MinCpuCores}" UpperValue="{Binding MaxCpuCores}"/>
                                    <TextBox Grid.Column="2" Text="{Binding MaxCpuCores, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="RAM, МБ (от и до)"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding MinRamMb, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:RangeSlider Grid.Column="1" Margin="12,0" Minimum="256" Maximum="65536" LowerValue="{Binding MinRamMb}" UpperValue="{Binding MaxRamMb}"/>
                                    <TextBox Grid.Column="2" Text="{Binding MaxRamMb, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Доля параллельных (0..1)"/>
                                        <TextBox Text="{Binding ParallelJobProbability, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Погрешность оценки (0..1)"/>
                                        <TextBox Text="{Binding EstimationError, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Button Style="{StaticResource ButtonPrimary}" Content="Сохранить workload" Command="{Binding SaveWorkloadCommand}" MinWidth="170" Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Сохраненные workload-ы"/>
                            <ListBox Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding AvailableWorkloads}" SelectedItem="{Binding SelectedWorkload}" DisplayMemberPath="Name"/>
                            <StackPanel Grid.Row="2">
                                <Button Content="Загрузить в редактор" Command="{Binding LoadWorkloadCommand}" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource ButtonDanger}" Content="Удалить" Command="{Binding DeleteSelectedWorkloadCommand}" Margin="0,0,0,6"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Style="{StaticResource CardSubtitle}" Text="{Binding WorkloadStatusMessage}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. Запуск симуляции -->
            <TabItem Header="3. Запуск симуляции">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel Margin="0,8,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Выбор кластеров для тестирования"/>
                                <TextBlock Style="{StaticResource CardSubtitle}" Margin="0,2,0,12" Text="Выберите один или несколько созданных кластеров."/>
                                <ListBox ItemsSource="{Binding AvailableClusters}" SelectionMode="Multiple"
                                         controls:ListBoxHelper.SelectedItems="{Binding SelectedClusters}"
                                         DisplayMemberPath="Name" MinHeight="120" MaxHeight="200"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Политика планирования"/>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Политика"/>
                                        <ComboBox ItemsSource="{Binding AvailablePolicies}" SelectedItem="{Binding SelectedPolicy}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <CheckBox Content="Строгий FIFO" IsChecked="{Binding StrictFifo}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Разрешить вытеснение" IsChecked="{Binding AllowPreemption}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="Сравнить все политики на этом workload" IsChecked="{Binding CompareAllPolicies}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Действия"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Каталог экспорта" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ButtonPrimary}" Content="Запустить симуляцию" Command="{Binding RunSimulationCommand}" MinWidth="190" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource ButtonSecondary}" Content="Экспортировать результаты" Command="{Binding ExportResultsCommand}" MinWidth="190"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Результаты (Заблокировано до запуска) -->
            <TabItem Header="Результаты" IsEnabled="{Binding HasResults}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,12">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Makespan, StringFormat={}{0:F0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Makespan, сек"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageWaitTime, StringFormat={}{0:F1}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Среднее ожидание, сек"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageTurnaround, StringFormat={}{0:F1}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Средний turnaround, сек"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageSlowdown, StringFormat={}{0:F2}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Средний slowdown"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ThroughputPerHour, StringFormat={}{0:F1}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Заданий в час"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding CpuUtilization, StringFormat={}{0:P0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Загрузка CPU"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding RamUtilization, StringFormat={}{0:P0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Загрузка RAM"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding CompletedJobs}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Завершено заданий"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding PreemptionCount}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Прерываний"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding CurrentTime, StringFormat={}{0:F0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Время конца прогона, сек"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding TimeSeries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время, сек" Binding="{Binding Time, StringFormat={}{0:F0}}" Width="100"/>
                                <DataGridTextColumn Header="Выполняется" Binding="{Binding RunningJobs}" Width="110"/>
                                <DataGridTextColumn Header="В очереди" Binding="{Binding PendingJobs}" Width="100"/>
                                <DataGridTextColumn Header="CPU занято" Binding="{Binding UsedCpuCores}" Width="100"/>
                                <DataGridTextColumn Header="CPU всего" Binding="{Binding TotalCpuCores}" Width="100"/>
                                <DataGridTextColumn Header="RAM занято, МБ" Binding="{Binding UsedRamMb}" Width="120"/>
                                <DataGridTextColumn Header="RAM всего, МБ" Binding="{Binding TotalRamMb}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 5. Задания (Заблокировано до запуска) -->
            <TabItem Header="Задания" IsEnabled="{Binding HasResults}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
                    <DataGrid ItemsSource="{Binding AllJobs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Владелец" Binding="{Binding Owner}" Width="90"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="110"/>
                            <DataGridTextColumn Header="Поступило, сек" Binding="{Binding SubmitTime, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="Старт, сек" Binding="{Binding StartTime, StringFormat={}{0:F1}}" Width="90"/>
                            <DataGridTextColumn Header="Финиш, сек" Binding="{Binding FinishTime, StringFormat={}{0:F1}}" Width="90"/>
                            <DataGridTextColumn Header="Ожидание, сек" Binding="{Binding WaitTime, StringFormat={}{0:F1}}" Width="100"/>
                            <DataGridTextColumn Header="Turnaround, сек" Binding="{Binding Turnaround, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding RequiredCpu}" Width="50"/>
                            <DataGridTextColumn Header="RAM, МБ" Binding="{Binding RequiredRamMb}" Width="80"/>
                            <DataGridTextColumn Header="Узлов" Binding="{Binding NodeCount}" Width="60"/>
                            <DataGridTextColumn Header="Узлы" Binding="{Binding AssignedNodes}" Width="90"/>
                            <DataGridTextColumn Header="Прерываний" Binding="{Binding Preemptions}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- 6. Сравнение политик (Заблокировано до запуска с флагом сравнения) -->
            <TabItem Header="Сравнение политик" IsEnabled="{Binding HasComparison}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
                    <DataGrid ItemsSource="{Binding Comparison}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Политика" Binding="{Binding Policy}" Width="130"/>
                            <DataGridTextColumn Header="Makespan, сек" Binding="{Binding Makespan, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="Ср. ожидание, сек" Binding="{Binding AverageWaitTime, StringFormat={}{0:F1}}" Width="120"/>
                            <DataGridTextColumn Header="Ср. turnaround, сек" Binding="{Binding AverageTurnaround, StringFormat={}{0:F1}}" Width="130"/>
                            <DataGridTextColumn Header="Ср. slowdown" Binding="{Binding AverageSlowdown, StringFormat={}{0:F2}}" Width="110"/>
                            <DataGridTextColumn Header="Загрузка CPU" Binding="{Binding CpuUtilization, StringFormat={}{0:P1}}" Width="110"/>
                            <DataGridTextColumn Header="Загрузка RAM" Binding="{Binding RamUtilization, StringFormat={}{0:P1}}" Width="110"/>
                            <DataGridTextColumn Header="Заданий в час" Binding="{Binding ThroughputPerHour, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="Завершено" Binding="{Binding CompletedJobs}" Width="90"/>
                            <DataGridTextColumn Header="Прерываний" Binding="{Binding PreemptionCount}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Статус-бар -->
        <Border Grid.Row="3" Style="{StaticResource StatusBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Text="{Binding CurrentTime, StringFormat=время: {0:F0} с}" VerticalAlignment="Center"/>
                <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>