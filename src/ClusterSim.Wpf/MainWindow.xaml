<Window x:Class="ClusterSim.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClusterSim.Wpf.Controls"
        Title="ClusterSim — симулятор кластерного планировщика"
        Width="1360" Height="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushAppBackground}">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="B" Background="Transparent" CornerRadius="8,8,0,0" Padding="16,10" Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Background="Transparent" Margin="12,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushSurface}"/>
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrushRowSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Style="{StaticResource TopBar}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppTitle}" Text="ClusterSim" VerticalAlignment="Center"/>
                <controls:ThemeSwitcherControl DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Индикатор -->
        <ProgressBar Grid.Row="1" Height="4" Background="{DynamicResource BrushTrack}" Foreground="{DynamicResource BrushAccent}" IsIndeterminate="{Binding IsRunning}"/>

        <TabControl Grid.Row="2" Margin="16,12,16,0">

            <!-- ================= 1. Кластеры ================= -->
            <TabItem Header="Кластеры">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource ButtonPrimary}" Content="Создать новый кластер"
                                    Command="{Binding CreateClusterCommand}" MinWidth="190" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource ButtonSecondary}" Content="Создать стандартный экземпляр"
                                    Command="{Binding CreateStandardClusterCommand}" MinWidth="220"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ClusterCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" DockPanel.Dock="Left"/>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button Style="{StaticResource ButtonGhost}" Content="Редактировать" Padding="8,4"
                                                            Command="{Binding DataContext.EditClusterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource ButtonGhost}" Content="Удалить" Padding="8,4"
                                                            Foreground="{DynamicResource BrushDanger}"
                                                            Command="{Binding DataContext.DeleteClusterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource CardSubtitle}" Text="{Binding Description}" Margin="0,2,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource KpiLabel}" Text="Узлов"/>
                                                    <TextBlock Text="{Binding NodeCount}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Style="{StaticResource KpiLabel}" Text="Ядер суммарно" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding TotalCores}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource KpiLabel}" Text="RAM суммарно, ГБ"/>
                                                    <TextBlock Text="{Binding TotalRamGb}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Style="{StaticResource KpiLabel}" Text="Диск суммарно, ГБ" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding TotalDiskGb}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="{DynamicResource BrushAccentSoft}" CornerRadius="6" Padding="8,4"
                                                    Margin="0,10,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding PolicyName, StringFormat=Политика: {0}}" FontSize="12"
                                                           Foreground="{DynamicResource BrushAccent}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 2. Задания ================= -->
            <TabItem Header="Задания">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource ButtonPrimary}" Content="Создать новый профиль заданий"
                                    Command="{Binding CreateWorkloadCommand}" MinWidth="220" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource ButtonSecondary}" Content="Создать стандартный экземпляр"
                                    Command="{Binding CreateStandardWorkloadCommand}" MinWidth="220"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding WorkloadCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" DockPanel.Dock="Left"/>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button Style="{StaticResource ButtonGhost}" Content="Редактировать" Padding="8,4"
                                                            Command="{Binding DataContext.EditWorkloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource ButtonGhost}" Content="Удалить" Padding="8,4"
                                                            Foreground="{DynamicResource BrushDanger}"
                                                            Command="{Binding DataContext.DeleteWorkloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource CardSubtitle}" Text="{Binding Description}" Margin="0,2,0,8"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Text="{Binding JobsInfo}"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding DurationInfo}" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding CpuInfo}" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Text="{Binding RamInfo}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 3. Запуск симуляции ================= -->
            <TabItem Header="Запуск симуляции">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel Margin="0,8,0,16">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Что и где запускаем"/>
                                <TextBlock Style="{StaticResource CardSubtitle}" Margin="0,2,0,12"
                                           Text="Отметьте профили заданий и кластеры. Ctrl+клик или Shift+клик для множественного выбора."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Профили заданий"/>
                                        <ListBox ItemsSource="{Binding AvailableWorkloads}"
                                                 SelectionMode="Multiple"
                                                 controls:ListBoxHelper.SelectedItems="{Binding SelectedWorkloads}"
                                                 DisplayMemberPath="Name" MinHeight="140" MaxHeight="220"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Кластеры"/>
                                        <ListBox ItemsSource="{Binding AvailableClusters}"
                                                 SelectionMode="Multiple"
                                                 controls:ListBoxHelper.SelectedItems="{Binding SelectedClusters}"
                                                 DisplayMemberPath="Name" MinHeight="140" MaxHeight="220"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Режим прогона"/>
                                <RadioButton GroupName="RunMode" Margin="0,8,0,6"
                                             Content="Сравнение кластеров: каждый выбранный кластер решает задания отдельно, сравнивается быстродействие"
                                             IsChecked="{Binding IsComparisonModeChecked}"/>
                                <RadioButton GroupName="RunMode"
                                             Content="Совместные кластеры: выбранные кластеры объединяются в одну систему и решают задания вместе"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Политика планирования"/>
                                <CheckBox Content="Использовать собственную политику каждого кластера (из редактора)"
                                          IsChecked="{Binding UseClusterPolicy}" Margin="0,6,0,10"/>
                                <UniformGrid Columns="2" IsEnabled="{Binding UseClusterPolicy, Converter={StaticResource InverseBool}}">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Политика для всех кластеров"/>
                                        <ComboBox ItemsSource="{Binding AvailablePolicies}" SelectedItem="{Binding SelectedPolicy}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <CheckBox Content="Строгий FIFO" IsChecked="{Binding StrictFifo}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Разрешить вытеснение" IsChecked="{Binding AllowPreemption}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="Дополнительно сравнить все политики (таблица «Сравнение политик»)"
                                          IsChecked="{Binding CompareAllPolicies}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Действия"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Каталог экспорта" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ButtonPrimary}" Content="Запустить симуляцию"
                                            Command="{Binding RunSimulationCommand}" MinWidth="190" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource ButtonSecondary}" Content="Экспортировать результаты"
                                            Command="{Binding ExportResultsCommand}" MinWidth="190"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 4. Результаты ================= -->
            <TabItem Header="Результаты" IsEnabled="{Binding HasResults}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,12">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Makespan, StringFormat={}{0:F0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Makespan, сек"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageWaitTime, StringFormat={}{0:F1}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Среднее ожидание, сек"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageTurnaround, StringFormat={}{0:F1}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Средний turnaround, сек"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageSlowdown, StringFormat={}{0:F2}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Средний slowdown"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ThroughputPerHour, StringFormat={}{0:F1}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Заданий в час"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding CpuUtilization, StringFormat={}{0:P0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Загрузка CPU"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding RamUtilization, StringFormat={}{0:P0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Загрузка RAM"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding CompletedJobs}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Завершено заданий"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding PreemptionCount}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Прерываний"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValue}" Text="{Binding CurrentTime, StringFormat={}{0:F0}}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Text="Время конца прогона, сек"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
                        <DataGrid ItemsSource="{Binding ClusterUtilization}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Кластер / прогон" Binding="{Binding ClusterLabel}" Width="*"/>
                                <DataGridTextColumn Header="Узлов" Binding="{Binding NodeCount}" Width="80"/>
                                <DataGridTextColumn Header="Загрузка CPU" Binding="{Binding CpuUtilization, StringFormat={}{0:P1}}" Width="120"/>
                                <DataGridTextColumn Header="Загрузка RAM" Binding="{Binding RamUtilization, StringFormat={}{0:P1}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding TimeSeries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время, сек" Binding="{Binding Time, StringFormat={}{0:F0}}" Width="100"/>
                                <DataGridTextColumn Header="Выполняется" Binding="{Binding RunningJobs}" Width="110"/>
                                <DataGridTextColumn Header="В очереди" Binding="{Binding PendingJobs}" Width="100"/>
                                <DataGridTextColumn Header="CPU занято" Binding="{Binding UsedCpuCores}" Width="100"/>
                                <DataGridTextColumn Header="CPU всего" Binding="{Binding TotalCpuCores}" Width="100"/>
                                <DataGridTextColumn Header="RAM занято, МБ" Binding="{Binding UsedRamMb}" Width="120"/>
                                <DataGridTextColumn Header="RAM всего, МБ" Binding="{Binding TotalRamMb}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= 5. Задания прогона ================= -->
            <TabItem Header="Задания прогона" IsEnabled="{Binding HasResults}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
                    <DataGrid ItemsSource="{Binding AllJobs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Владелец" Binding="{Binding Owner}" Width="90"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="110"/>
                            <DataGridTextColumn Header="Поступило, сек" Binding="{Binding SubmitTime, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="Старт, сек" Binding="{Binding StartTime, StringFormat={}{0:F1}}" Width="90"/>
                            <DataGridTextColumn Header="Финиш, сек" Binding="{Binding FinishTime, StringFormat={}{0:F1}}" Width="90"/>
                            <DataGridTextColumn Header="Ожидание, сек" Binding="{Binding WaitTime, StringFormat={}{0:F1}}" Width="100"/>
                            <DataGridTextColumn Header="Turnaround, сек" Binding="{Binding Turnaround, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding RequiredCpu}" Width="50"/>
                            <DataGridTextColumn Header="RAM, МБ" Binding="{Binding RequiredRamMb}" Width="80"/>
                            <DataGridTextColumn Header="Узлов" Binding="{Binding NodeCount}" Width="60"/>
                            <DataGridTextColumn Header="Узлы" Binding="{Binding AssignedNodes}" Width="90"/>
                            <DataGridTextColumn Header="Прерываний" Binding="{Binding Preemptions}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- ================= 6. Сравнение политик ================= -->
            <TabItem Header="Сравнение политик" IsEnabled="{Binding HasComparison}">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
                    <DataGrid ItemsSource="{Binding Comparison}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Вариант" Binding="{Binding Policy}" Width="260"/>
                            <DataGridTextColumn Header="Makespan, сек" Binding="{Binding Makespan, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="Ср. ожидание, сек" Binding="{Binding AverageWaitTime, StringFormat={}{0:F1}}" Width="120"/>
                            <DataGridTextColumn Header="Ср. turnaround, сек" Binding="{Binding AverageTurnaround, StringFormat={}{0:F1}}" Width="130"/>
                            <DataGridTextColumn Header="Ср. slowdown" Binding="{Binding AverageSlowdown, StringFormat={}{0:F2}}" Width="110"/>
                            <DataGridTextColumn Header="Загрузка CPU" Binding="{Binding CpuUtilization, StringFormat={}{0:P1}}" Width="110"/>
                            <DataGridTextColumn Header="Загрузка RAM" Binding="{Binding RamUtilization, StringFormat={}{0:P1}}" Width="110"/>
                            <DataGridTextColumn Header="Заданий в час" Binding="{Binding ThroughputPerHour, StringFormat={}{0:F1}}" Width="110"/>
                            <DataGridTextColumn Header="Завершено" Binding="{Binding CompletedJobs}" Width="90"/>
                            <DataGridTextColumn Header="Прерываний" Binding="{Binding PreemptionCount}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Статус-бар -->
        <Border Grid.Row="3" Style="{StaticResource StatusBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                           Text="{Binding CurrentTime, StringFormat=время: {0:F0} с}" VerticalAlignment="Center"/>
                <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>