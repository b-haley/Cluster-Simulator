<Window x:Class="ClusterSim.Wpf.Views.ClusterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор кластера"
        Width="760" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Паспорт кластера"/>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Название"/>
                                <TextBox Text="{Binding ClusterName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Описание"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Быстрая конфигурация"/>
                        <UniformGrid Columns="4" Margin="0,8,0,10">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Узлов"/>
                                <TextBox Text="{Binding TemplateNodeCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ядер на узел"/>
                                <TextBox Text="{Binding TemplateCpuCores, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RAM на узел, ГБ"/>
                                <TextBox Text="{Binding TemplateRamGb, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Диск на узел, ГБ"/>
                                <TextBox Text="{Binding TemplateDiskGb, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Сгенерировать узлы по шаблону"
                                Command="{Binding GenerateNodesFromTemplateCommand}"
                                HorizontalAlignment="Left" MinWidth="240"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Узлы кластера"/>
                        <DataGrid ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                  MinHeight="160" MaxHeight="260" Margin="0,8,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя узла" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="Ядер CPU" Binding="{Binding CpuCores, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <DataGridTextColumn Header="RAM, ГБ" Binding="{Binding RamGb, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <DataGridTextColumn Header="Диск, ГБ" Binding="{Binding DiskGb, UpdateSourceTrigger=LostFocus}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Добавить узел" Command="{Binding AddNodeCommand}" MinWidth="140" Margin="0,0,8,0"/>
                            <Button Content="Удалить выбранный" Command="{Binding RemoveSelectedNodeCommand}" MinWidth="160"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Планировщик кластера"/>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Политика планирования"/>
                                <ComboBox ItemsSource="{Binding AvailablePolicies}" SelectedItem="{Binding Policy}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox Content="Строгий FIFO" IsChecked="{Binding StrictFifo}" Margin="0,0,0,6"/>
                                <CheckBox Content="Разрешить вытеснение" IsChecked="{Binding AllowPreemption}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalNodes}"/>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Узлов"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalCores}"/>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Ядер суммарно"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalRamGb}"/>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="RAM суммарно, ГБ"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalDiskGb}"/>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Диск суммарно, ГБ"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource ButtonPrimary}" Content="Сохранить"
                    Command="{Binding SaveCommand}" MinWidth="140" Margin="0,0,8,0"/>
            <Button Style="{StaticResource ButtonSecondary}" Content="Отмена"
                    Command="{Binding CancelCommand}" MinWidth="120"/>
        </StackPanel>
    </Grid>
</Window>