<UserControl x:Class="ClusterSim.Wpf.Controls.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClusterSim.Wpf.Controls">
    <Border Background="{DynamicResource BrushTopBar}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1"
            Padding="16,0">
        <DockPanel LastChildFill="False" Height="40">
            <TextBlock DockPanel.Dock="Left" Text="ClusterSim"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       VerticalAlignment="Center"/>
            <controls:ThemeSwitcherControl DockPanel.Dock="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
            <Button x:Name="MinimizeButton" DockPanel.Dock="Right"
                    Style="{StaticResource ButtonGhost}"
                    Content="—" Width="40" Height="32"
                    Click="Minimize_Click"/>
            <Button x:Name="MaximizeButton" DockPanel.Dock="Right"
                    Style="{StaticResource ButtonGhost}"
                    Content="☐" Width="40" Height="32"
                    Click="Maximize_Click"/>
            <Button x:Name="CloseButton" DockPanel.Dock="Right"
                    Style="{StaticResource ButtonDanger}"
                    Content="✕" Width="40" Height="32"
                    Click="Close_Click"/>
        </DockPanel>
    </Border>
</UserControl>